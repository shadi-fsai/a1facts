
# Paste your RDFS example here
@prefix : <http://example.org/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# --- Market Entities ---
:Crop_Protection_Market a :Market ;
    :name "Crop Protection" ;
    :rivalry_intensity "High" ;
    :barriers_to_entry "High R&D spend, regulatory approval, but moderate switching costs and high substitutability due to patent cliffs and generics." ;
    :sources "Section 8-Industry Rivalry, sourced from 2023–2024 annual reports, Porter's analysis in provided source" .

# --- Company Entities ---
:FMC_Corporation a :Company ;
    :name "FMC Corporation" ;
    :company_type "Public Company" ;
    :industry_code "GICS:15101030" ;
    :business_model "Crop protection pure-play; post-2017 focuses on agricultural chemicals, post-DuPont acquisition and Livent spin-off; since 2023 restructuring to focus on biologicals & precision tools, reduced non-core businesses, asset-light partnerships (Corteva 2025)." ;
    :governance_notes "Class-action securities suit pending regarding 2025 guidance mis-statements." ;
    :macro_environment_notes "Industry faces cycles from commodity prices and regulatory pressure." ;
    :customer_concentration_notes "No single customer concentration noted; typical of diversified crop protection customer base." ;
    :culture_and_labor_notes "Emphasis on innovation and partnership since 2023 restructuring." ;
    :operational_risk_notes "Competitive litigation, risk from biological disruptors, patent cliffs, ongoing industry litigation on glyphosate, dicamba." ;
    :sources "FMC 2024 Form 10-K, 2023–2024 annual reports, Section 7/8 of provided source." .
:Syngenta_Group a :Company ;
    :name "Syngenta Group" ;
    :company_type "Public Company" ;
    :industry_code "GICS:15101030" ;
    :business_model "Chemicals, biologicals, seeds & traits, digital agri solutions." ;
    :sources "FMC 2024 Form 10-K, Syngenta 2023 annual report, product literature." .
:Bayer_Crop_Science a :Company ;
    :name "Bayer Crop Science" ;
    :company_type "Public Company" ;
    :industry_code "GICS:15101030" ;
    :business_model "Chemicals, biologicals, seeds & traits, digital agri solutions (FieldView)." ;
    :sources "FMC 2024 Form 10-K, Bayer 2024 annual report, product literature." .
:BASF_Agricultural_Solutions a :Company ;
    :name "BASF Agricultural Solutions" ;
    :company_type "Public Company" ;
    :industry_code "GICS:15101030" ;
    :business_model "Chemicals, seeds, biologicals, digital agri solutions (xarvio)." ;
    :sources "FMC 2024 Form 10-K, BASF 2024 annual report, product literature." .
:Corteva_Agriscience a :Company ;
    :name "Corteva Agriscience" ;
    :company_type "Public Company" ;
    :industry_code "GICS:15101030" ;
    :business_model "Chemicals, biologicals (Stoller, Symborg), seeds, digital (Granular)." ;
    :sources "FMC 2024 Form 10-K, Corteva 2023 annual report, product literature." .
:UPL_Ltd a :Company ;
    :name "UPL Ltd." ;
    :company_type "Public Company" ;
    :industry_code "GICS:15101030" ;
    :business_model "Chemicals, biologicals (ProNutiva), seeds (Advanta), digital." ;
    :sources "FMC 2024 Form 10-K, UPL 2023 annual report, product literature." .
:Sumitomo_Chemical_Co a :Company ;
    :name "Sumitomo Chemical Co. Ltd." ;
    :company_type "Public Company" ;
    :industry_code "GICS:15101030" ;
    :business_model "Chemicals, biorationals (Valent BioSciences)." ;
    :sources "FMC 2024 Form 10-K, Sumitomo 2023 annual report, product literature." .
:Nufarm_Ltd a :Company ;
    :name "Nufarm Ltd." ;
    :company_type "Public Company" ;
    :industry_code "GICS:15101030" ;
    :business_model "Chemicals, biological JV, seeds (Nuseed)." ;
    :sources "FMC 2024 Form 10-K, Nufarm 2023 annual report, product literature." .

