# --- Corporate Events: Major Turning Points ---
:Event_FMC_Acq_DuPont a :Corporate_Event ;
    :event_type "Acquisition" ;
    :event_date "2017-03-31"^^xsd:date ;
    :is_material true ;
    :is_turning_point true ;
    :event_description "FMC acquired DuPont crop chemical assets, transforming into a crop protection-focused company. P/S jumped 90%." ;
    :sources "provided source, Section 3.3" .
:Event_FMC_Guidance_Cut_2023 a :Corporate_Event ;
    :event_type "Earnings" ;
    :event_date "2023-10-01"^^xsd:date ;
    :is_material true ;
    :is_turning_point true ;
    :event_description "FMC issued earnings guidance cut due to channel destocking; P/E fell from 22×→14×." ;
    :sources "provided source, Section 3.3" .

:FMC_Corporation :is_subject_of :Event_FMC_Acq_DuPont, :Event_FMC_Guidance_Cut_2023 .

# --- Risk Entities: Key Legal and Litigation Risks ---
:Bayer_Glyphosate_Litigation a :Risk ;
    :risk_id "Bayer_Glyphosate_Litigation_2018-2025" ;
    :risk_type "Legal" ;
    :description "Glyphosate carcinogenicity lawsuits against Bayer Crop Science, settlements >US$14bn, ongoing appeals." ;
    :status "Ongoing" ;
    :sources "Section 5 of provided source" .
:BASF_Bayer_Dicamba_Suits a :Risk ;
    :risk_id "BASF_Bayer_Dicamba_2017-2021" ;
    :risk_type "Legal" ;
    :description "Dicamba drift suits: Crop damage claims, US$400m joint settlement (Bayer), BASF share undisclosed." ;
    :status "Resolved" ;
    :sources "Section 5 of provided source" .
:FMC_UPL_Patent_2015 a :Risk ;
    :risk_id "FMC_UPL_Patent_Settlement_2015" ;
    :risk_type "Legal" ;
    :description "FMC vs. UPL patent infringement – sulfentrazone: settled, FMC received royalty." ;
    :status "Resolved" ;
    :sources "Section 5 of provided source" .
:Corteva_UPL_Patent_2020 a :Risk ;
    :risk_id "Corteva_UPL_Patent_2020_22" ;
    :risk_type "Legal" ;
    :description "Corteva vs. UPL patent on Rinskor™ analogs: ITC ruled for Corteva, limited UPL imports." ;
    :status "Resolved" ;
    :sources "Section 5 of provided source" .
:Syngenta_BASF_SDHI_2017 a :Risk ;
    :risk_id "Syngenta_BASF_SDHI_2017_19" ;
    :risk_type "Legal" ;
    :description "Syngenta vs. BASF patent on SDHI fungicide classes: cross-licence agreed, no damages." ;
    :status "Resolved" ;
    :sources "Section 5 of provided source" .
:FMC_Securities_Class_Action_2025 a :Risk ;
    :risk_id "FMC_Securities_Class_Action_2025" ;
    :risk_type "Legal" ;
    :description "Class-action suit against FMC for guidance mis-statements in 2025. Motions to dismiss filed July 2025." ;
    :status "Ongoing" ;
    :sources "Section 5 of provided source" .

